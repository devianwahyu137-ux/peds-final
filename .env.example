# AlphaShield Environment Variables
# Copy this file to .env and fill in your actual keys

# ── AI Chat Providers (pick one) ────────────────────────────
# Anthropic Claude (preferred — streaming)
VITE_ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI GPT-4o-mini (fallback — streaming)
VITE_OPENAI_API_KEY=your_openai_key_here

# Google Gemini (legacy fallback — non-streaming)
VITE_GEMINI_API_KEY=your_gemini_key_here

# ── Data Sources ────────────────────────────────────────────
# Supabase (Primary data source — Realtime WebSocket)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# FRED API (Secondary — backup polling)
VITE_FRED_API_KEY=your-fred-key

# Alpha Vantage (Secondary — backup polling)
VITE_ALPHAVANTAGE_KEY=your-av-key
